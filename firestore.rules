rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // كل مستخدم يقرأ فقط وثيقته الخاصة.
      allow read: if request.auth != null && request.auth.uid == uid;

      // حقول الاشتراك (subscribed, stripeCustomerId, subscribedAt, stripeSessionId)
      // محمية بالكامل — التفعيل الوحيد المسموح به يأتي من Cloud Function عبر Admin SDK
      // (Admin SDK يتجاوز قواعد الأمان هذه بالكامل). العميل مسموح له فقط بكتابة
      // نسخة احتياطية سحابية من بيانات أطفاله (childrenData) ومنصّة الجهاز (platform،
      // حقل بيانات عادي لا حدث تتبّع) — راجع pullChildrenFromCloud/syncChildrenToCloud
      // في horofi-v11-9-29.html.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['childrenData', 'childrenUpdatedAt', 'platform']);

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['childrenData', 'childrenUpdatedAt', 'platform'])
        && (!('subscribed' in resource.data) || request.resource.data.subscribed == resource.data.subscribed)
        && (!('stripeCustomerId' in resource.data) || request.resource.data.stripeCustomerId == resource.data.stripeCustomerId)
        && (!('subscribedAt' in resource.data) || request.resource.data.subscribedAt == resource.data.subscribedAt)
        && (!('stripeSessionId' in resource.data) || request.resource.data.stripeSessionId == resource.data.stripeSessionId);

      // حذف الحساب: المستخدم يملك حذف وثيقته بالكامل (طلب "حذف الحساب نهائياً" في الواجهة).
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // إعدادات عامة للقراءة فقط (حالياً: config/appVersion = أرقام البناء المنشورة
    // في المتجرين، يقرأها checkForAppUpdate). لا بيانات شخصية هنا إطلاقاً، والكتابة
    // ممنوعة على العميل نهائياً — تُحدَّث يدوياً من Firebase Console بعد نشر كل إصدار.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
